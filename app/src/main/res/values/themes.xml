<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- EXAONE Theme -->
    <style name="Theme.ExaoneAgent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/exaone_red</item>
        <item name="colorPrimaryVariant">@color/exaone_red_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/exaone_red</item>
        <item name="colorSecondaryVariant">@color/exaone_red_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background_white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background color -->
        <item name="android:colorBackground">@color/background_white</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.ExaoneAgent.Button</item>
        
        <!-- Popup Menu Style (Global) -->
        <item name="popupMenuStyle">@style/Widget.ExaoneAgent.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.ExaoneAgent.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.ExaoneAgent.PopupMenu</item>
        
        <!-- Force Rounded List Selector for Menus -->
        <item name="android:dropDownListViewStyle">@style/Widget.ExaoneAgent.ListView.DropDown</item>
        
        <!-- Material Alert Dialog Theme -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ExaoneAgent.MaterialAlertDialog</item>
        
        <!-- Android 12+ Splash Screen -->
        <item name="android:windowSplashScreenBackground">@color/background_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/background_white</item>
        
        <!-- Snackbar Style -->
        <item name="snackbarStyle">@style/Widget.ExaoneAgent.Snackbar</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.ExaoneAgent.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_round</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Custom Snackbar Style -->
    <style name="Widget.ExaoneAgent.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_snackbar</item>
        <item name="android:layout_margin">16dp</item> <!-- 화면에서 띄우기 -->
    </style>

    <!-- Material Alert Dialog Style -->
    <style name="ThemeOverlay.ExaoneAgent.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ExaoneAgent.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.ExaoneAgent.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_round</item>
    </style>

    <style name="ShapeAppearance.ExaoneAgent.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_round</item>
    </style>

    <!-- Custom List View Style for Dropdowns (Menus) -->
    <style name="Widget.ExaoneAgent.ListView.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@drawable/ripple_rounded</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <!-- Global TextInputLayout Style -->
    <style name="Widget.ExaoneAgent.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/box_stroke_color</item>
        <item name="startIconTint">@color/text_hint</item>
    </style>

    <!-- Custom Popup Menu Style -->
    <style name="Widget.ExaoneAgent.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Toolbar Popup Theme: 팝업 내부의 아이템 클릭 효과 제어 -->
    <style name="Theme.ExaoneAgent.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <!-- 팝업 메뉴 배경 -->
        <item name="android:colorBackground">@color/background_white</item>
        <item name="android:textColor">@color/text_primary</item>
        
        <!-- 핵심: 아이템 클릭 시 둥근 리플 효과 강제 적용 -->
        <item name="android:selectableItemBackground">@drawable/ripple_rounded</item>
        <item name="selectableItemBackground">@drawable/ripple_rounded</item>
    </style>
</resources>